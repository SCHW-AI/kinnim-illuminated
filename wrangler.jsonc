{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kinnim-illuminated",
  "compatibility_date": "2026-09-01",
  // Assets-only Worker: no script. Unknown paths fall back to index.html so
  // client-side routes (e.g. /mishnah/1-2) survive a refresh.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Keep the workers.dev address live alongside the custom domains.
  "workers_dev": true,
  // Custom domains: Cloudflare creates the DNS records and certificates.
  "routes": [
    { "pattern": "kinnim-illuminated.com", "custom_domain": true },
    { "pattern": "www.kinnim-illuminated.com", "custom_domain": true },
  ],
}
